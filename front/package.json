{
  "name": "slotfinder-front",
  "version": "0.1.0",
  "description": "SlotFinder front-end",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "rsbuild dev",
    "start:mock": "rsbuild dev --port 3003 --env-mode mock",
    "start:storybook": "storybook dev -p 3002",
    "build": "rsbuild build",
    "build:storybook": "storybook build",
    "preview": "rsbuild preview",
    "test": "vitest run --config config/vitest/workspace.ts",
    "test:unit": "vitest run --config config/vitest/vitest.unit.config.ts",
    "test:unit:watch": "vitest --config config/vitest/vitest.unit.config.ts",
    "test:browser": "vitest --config=config/vitest/vitest.browser.config.ts --run",
    "test:browser:update": "vitest --config=config/vitest/vitest.browser.config.ts --run --update",
    "test:browser:watch": "vitest --config=config/vitest/vitest.browser.config.ts",
    "lint": "node scripts/lint.js",
    "lint:oxlint": "oxlint src/ mocks/",
    "lint:oxlint:fix": "oxlint --fix src/ mocks/",
    "lint:stylelint": "stylelint \"src/**/*.{scss,css}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "lint:oxfmt": "oxfmt --check src/ mocks/ public/",
    "lint:oxfmt:fix": "oxfmt src/ mocks/ public/",
    "lint:tsc": "tsc --noEmit",
    "package:check": "npm exec --yes package-lock-utd@1.1.3",
    "generate:i18next": "i18next-resources-for-ts toc -i ./src/i18n/locales/en -o ./src/i18n/@types/resources.ts",
    "generate:api": "node scripts/prepare-swagger.mjs && orval",
    "postinstall": "msw init && npm run generate:api"
  },
  "dependencies": {
    "@hookform/resolvers": "5.6.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@material-symbols/svg-300": "0.45.9",
    "@material-symbols/svg-400": "0.45.9",
    "@tanstack/react-query": "5.101.4",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@pplancq/stylelint-config": "5.0.3",
    "@rsbuild/core": "2.1.9",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-sass": "2.0.1",
    "@rsbuild/plugin-svgr": "2.0.5",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-onboarding": "10.5.5",
    "@storybook/react": "10.5.5",
    "@tanstack/react-query-devtools": "5.101.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "chromatic": "18.1.0",
    "concurrently": "10.0.4",
    "i18next-resources-for-ts": "2.1.0",
    "jsdom": "30.0.1",
    "monocart-coverage-reports": "2.12.12",
    "msw": "2.15.0",
    "orval": "^8.23.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.5.5",
    "storybook-react-rsbuild": "3.3.4",
    "stylelint": "17.14.1",
    "stylelint-scss": "7.2.0",
    "tsc-files": "1.1.4",
    "typescript": "7.0.2",
    "vite-plugin-svgr": "5.2.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "vitest-axe": "1.0.0-pre.5",
    "vitest-browser-react": "2.2.0",
    "vitest-sonar-reporter": "3.0.0"
  },
  "allowScripts": {
    "msw@2.15.0": true,
    "esbuild@0.28.1": true,
    "@swc/core@1.15.47": true,
    "@parcel/watcher@2.6.0": true
  },
  "msw": {
    "workerDirectory": [
      "./public"
    ]
  }
}
